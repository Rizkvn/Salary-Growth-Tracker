# =============================================================================
# Salary Growth Tracker — Environment Configuration
# =============================================================================
# Copy this file to .env before starting Docker Compose:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT REPOSITORY.
# =============================================================================

# Backend Authentication & Security (REQUIRED)
APP_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Host Port Bindings
BACKEND_PORT=8000
FRONTEND_PORT=5174

# Frontend API URL
# NOTE: This URL is used by the USER'S WEB BROWSER on the host machine to reach
# the FastAPI backend. It must point to the backend host port reachable from
# your browser (e.g., http://localhost:8000), NOT internal container DNS.
VITE_API_BASE_URL=http://localhost:8000
